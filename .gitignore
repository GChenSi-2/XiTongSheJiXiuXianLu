# ===== Obsidian 内部状态（高频变动、无需版本管理）=====
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 垃圾桶 =====
.trash/

# ===== 临时文件 =====
*.tmp
*.bak
*.swp

# ===== 如果你用 Dataview 生成的缓存 =====
.obsidian/plugins/dataview/data.json

# ===== Claudian AI 助手会话文件（对话历史，无需版本管理）=====
.claudian/sessions/

# ===== 插件自动生成的缓存（可随时重建）=====
.obsidian/plugins/text-extractor/cache/
.smart-env/multi/
.smart-env/event_logs/

/.quarto/
**/*.quarto_ipynb

/.claudian/claudian-settings.json
/.gitignore
/_ai-assistant/current-note.json
# ===== 大型数据文件（scRNA-seq 原始/中间数据，超过 GitHub 100MB 上限，不进 git）=====
Bioinformatics/HBC/Rworkspace/**/data/
Bioinformatics/HBC/workspace/**/data/
*.h5ad
*.rds
*.RData
*.RData.bz2
*.mtx.gz

# macOS 压缩包残留
__MACOSX/

/_ai-assistant/current-note.json
/.gitignore

# Quartz 发布构建产物
/public/
/.quartz-build/
