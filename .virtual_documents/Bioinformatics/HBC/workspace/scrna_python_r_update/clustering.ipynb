# Load libraries
import scanpy as sc
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt
import sys

# 改了 util/ 里的 .py 后自动重新加载，不用重启 kernel
%load_ext autoreload
%autoreload 2

sys.path.append("util")
from pca_heatmap import pca_heatmap

# Load data
adata_integrated = sc.read_h5ad("data/adata_integrated.h5ad")

# Set randomness
np.random.seed(1234)


pca_heatmap(adata_integrated) 


# Print top and bottom ranked genes for first 3 PCs
sc.pl.pca_loadings(adata_integrated,
                   components = "1,2,3")


   pc = 0  # PC1
   order = np.argsort(adata_integrated.varm['PCs'][:, pc])
   genes = adata_integrated.var_names
   print("bottom:", genes[order[:10]].tolist())
   print("top:", genes[order[-10:]].tolist())


# PC1/PC2 colored by condition, IFN response, and lineage markers
# (no cell_type column yet, so CD14 = myeloid, CD3E = T cells as stand-ins)
sc.pl.pca(adata_integrated,
          color=['sample', 'ISG15', 'CD14', 'CD3E'],
          components=['1,2'],
          ncols=2)





# Check scVI integration: neighbors + UMAP on the integrated latent space
sc.pp.neighbors(adata_integrated, use_rep='X_scvi')
sc.tl.umap(adata_integrated)
sc.pl.umap(adata_integrated,
           color=['sample', 'CD3E', 'LYZ', 'ISG15'],
           ncols=2)





# Elbow plot visualization
sc.pl.pca_variance_ratio(adata_integrated, 
                         n_pcs = 50, log = True)


# Calculate neighbors
sc.pp.neighbors(adata_integrated, 
                use_rep = "X_scvi", 
                key_added = "scvi",
                random_state = 1234)


# Calculation of UMAP
sc.tl.umap(adata_integrated,
           neighbors_key = "scvi", 
           key_added = "umap_scvi",
           random_state = 1234)


# UMAP colored by sample
sc.pl.embedding(adata_integrated, 
                color = "sample", 
                basis = "umap_scvi")


adata_integrated


# List of resolution values to test
resolutions = [0.4, 0.6, 0.8, 1.0, 1.4]

for res in resolutions:
    sc.tl.leiden(adata_integrated,
                 flavor = "igraph", 
                 n_iterations = 2, 
                 neighbors_key = "scvi", 
                 resolution = res,
                 key_added = f"leiden_{res}")


# View updated metadata
adata_integrated.obs.head()


# Number of cells per cluster
adata_integrated.obs["leiden_0.8"].value_counts()


# Plot the UMAP
sc.pl.embedding(adata_integrated, 
                color = "leiden_0.8", 
                basis = "umap_scvi",
                legend_loc = "on data",
                legend_fontsize = 14,
                legend_fontoutline = 3)


# Plot the UMAP
sc.pl.embedding(adata_integrated, 
                color = "leiden_0.4", 
                basis = "umap_scvi",
                legend_loc = "on data",
                legend_fontsize = 14,
                legend_fontoutline = 3)



